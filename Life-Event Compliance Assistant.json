    {
      "parameters": {
        "jsCode": "// Swappable jurisdiction pack (Step 2). Add EU/US packs as new keys later without touching logic.\nconst packs = {\n  'TN:started_freelancing': [\n    { action: 'Register with CNSS as self-employed', institution: 'CNSS', deadline_days_from_event: 30, form_available: true, severity: 'high' },\n    { action: 'Choose tax regime (forfaitaire vs reel)', institution: 'Direction Generale des Impots', deadline_days_from_event: 30, form_available: false, severity: 'high' },\n    { action: 'Notify bank of self-employed status for account type', institution: 'Bank', deadline_days_from_event: 60, form_available: false, severity: 'low' },\n  ],\n};\n\nconst cls = ($input.first().json.output) || {};\nconst form = $('Event Form').first().json;\nconst country = 'TN';\nconst eventType = String(cls.event_type || form['Event Type'] || '').trim();\nconst eventDateRaw = form['Event Date'] || (Array.isArray(cls.extracted_dates) && cls.extracted_dates[0]) || $today.toISODate();\nconst parsed = DateTime.fromISO(String(eventDateRaw));\nconst baseDate = parsed.isValid ? parsed : DateTime.now();\nconst eventId = country + '-' + (eventType || 'unknown') + '-' + Date.now();\n\nconst checklist = packs[country + ':' + eventType] || [];\n\nif (checklist.length === 0) {\n  return [{ json: {\n    pack_found: false,\n    event_id: eventId, event_type: eventType, country,\n    action: 'No jurisdiction pack found for this event type - manual review required',\n    institution: 'N/A',\n    deadline_date: baseDate.plus({ days: 14 }).toISODate(),\n    status: 'open', form_available: false, severity: 'medium',\n  } }];\n}\n\nconst rows = [];\nfor (const item of checklist) {\n  rows.push({ json: {\n    pack_found: true,\n    event_id: eventId,\n    event_type: eventType,\n    country,\n    action: item.action,\n    institution: item.institution,\n    deadline_date: baseDate.plus({ days: item.deadline_days_from_event }).toISODate(),\n    status: 'open',\n    form_available: item.form_available,\n    severity: item.severity,\n  } });\n}\nreturn rows;"
      },
