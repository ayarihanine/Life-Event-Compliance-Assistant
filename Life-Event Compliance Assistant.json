      "parameters": {
        "promptType": "define",
        "text": "=A user reported a life event via a form.\n\nEvent type selected: {{ $json[\"Event Type\"] }}\nEvent date: {{ $json[\"Event Date\"] }}\nAdditional details: {{ $json[\"Details\"] }}",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "You are a compliance-intake classifier for a personal administrative assistant. The user selected a canonical event_type from a fixed dropdown, so use the selected event_type as authoritative unless the details clearly contradict it. The canonical set is: started_freelancing, new_child, lost_job, moved_address, business_registered, family_member_deceased, visa_renewal. Set confidence to high, medium, or low. Put any dates you can identify into extracted_dates as ISO (YYYY-MM-DD) strings, and any institutions, reference numbers, or names into extracted_entities. Set needs_human_review to true only when the details clearly contradict the selected event_type or are self-contradictory. Return only the structured object."
            }
          ]
        },
        "batching": {}
      },
